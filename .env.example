# ============================================================================
# Agentic Commerce Platform - environment configuration
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# The defaults below run the ENTIRE project offline: no AWS account, no
# Razorpay keys, no spend. Change AI_PROVIDER and RAZORPAY_MODE when you are
# ready to use real services. Never commit your .env file.
# ============================================================================

# --- Application ------------------------------------------------------------
# REQUIRED. development | test | production
ENVIRONMENT=development
# OPTIONAL. DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# OPTIONAL. console for local readability, json for CloudWatch Logs Insights.
LOG_FORMAT=console

# --- AI provider ------------------------------------------------------------
# REQUIRED. mock = deterministic offline provider (no AWS). bedrock = AWS Bedrock.
AI_PROVIDER=mock

# --- AWS --------------------------------------------------------------------
# REQUIRED when AI_PROVIDER=bedrock. Must be a region where you enabled Bedrock.
AWS_REGION=ap-south-1
# LOCAL ONLY. Prefer `aws configure` or AWS_PROFILE over pasting keys here.
# In production these MUST be empty - ECS task roles supply credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# OPTIONAL, LOCAL ONLY. Named profile from ~/.aws/credentials.
AWS_PROFILE=

# --- Bedrock ----------------------------------------------------------------
# REQUIRED when AI_PROVIDER=bedrock. You must request access to this model first.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# REQUIRED when AI_PROVIDER=bedrock. Titan v2 or a Cohere Embed model.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# OPTIONAL. Generation limits.
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.0
# OPTIONAL. Bedrock Guardrails applied to the buyer agent's reasoning.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# --- Razorpay (TEST MODE ONLY) ---------------------------------------------
# REQUIRED. mock = offline simulator. test = real Razorpay test-mode API.
RAZORPAY_MODE=mock
# REQUIRED when RAZORPAY_MODE=test. Live keys (rzp_live_...) are refused at startup.
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
# OPTIONAL. Only needed if you configure a Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- AP2 spending mandates --------------------------------------------------
# REQUIRED. HMAC signing key. Generate: python -c "import secrets;print(secrets.token_hex(32))"
AP2_MANDATE_SECRET=change_me_generate_a_random_64_char_hex_string
# OPTIONAL. Mandate lifetime in seconds.
AP2_MANDATE_TTL_SECONDS=900
# OPTIONAL. Hard platform ceiling in paise. 500000 = Rs 5,000. No mandate may exceed this.
AP2_ABSOLUTE_MAX_AMOUNT=500000

# --- Storage ----------------------------------------------------------------
# REQUIRED. sqlite (local) | dynamodb (production)
LEDGER_BACKEND=sqlite
# LOCAL ONLY. SQLite files for the two hash-chained ledgers.
DATABASE_URL=sqlite:///./data/merchant_ledger.db
BUYER_DATABASE_URL=sqlite:///./data/buyer_ledger.db
# PRODUCTION. DynamoDB table created by infrastructure/cloudformation.yaml.
DYNAMODB_TABLE_NAME=acp-audit-ledger
# OPTIONAL. Set to http://localhost:8002 to use DynamoDB Local.
DYNAMODB_ENDPOINT_URL=

# --- Security ---------------------------------------------------------------
# PRODUCTION. Secrets Manager secret holding a JSON bundle of the values above.
SECRETS_MANAGER_SECRET_NAME=
# OPTIONAL. KMS key used to encrypt the DynamoDB ledger table.
KMS_KEY_ID=
# REQUIRED. Shared secret authenticating buyer -> merchant A2A calls.
A2A_API_KEY=local-dev-a2a-key

# --- Networking -------------------------------------------------------------
# REQUIRED. How the buyer agent reaches the merchant agent.
MERCHANT_AGENT_URL=http://localhost:8000
BUYER_AGENT_URL=http://localhost:8001
MERCHANT_AGENT_PORT=8000
BUYER_AGENT_PORT=8001
HTTP_TIMEOUT_SECONDS=30

# --- Catalog ----------------------------------------------------------------
# OPTIONAL. Seed catalog and embedding cache locations.
CATALOG_PATH=./data/catalog.json
EMBEDDING_CACHE_PATH=./data/embedding_cache.json
